digraph ARCH {
  graph [rankdir=TB, bgcolor="white", pad=0.4, nodesep=0.5, ranksep=0.7, fontname="Helvetica",
         label="ReRoute: System Architecture", labelloc=t, fontsize=22, compound=true];
  node  [fontname="Helvetica", fontsize=12, shape=box, style="rounded,filled", fillcolor="#ffffff", color="#475569"];
  edge  [fontname="Helvetica", fontsize=10, color="#475569"];

  IN [label="Supplier delay email / webhook", fillcolor="#e0f2fe", color="#0369a1"];

  subgraph cluster_n8n {
    label="n8n (workflow engine)"; style="rounded,filled"; fillcolor="#fff1f5"; color="#ea4b71"; fontsize=14;
    W1 [label="W1 Intake\nLLM extraction + validation"];
    W2 [label="W2 Analyst Agent\ntool-calling LLM"];
    W3 [label="W3 Executor\nparallel RFQs, Wait, quote parsing,\napproval, PO, customer notices"];
    W4 [label="W4 Watchdog (scheduled)\nverify, chase, re-plan, escalate, close"];
    W5 [label="W5 Supplier Simulator\n(demo personas)", fillcolor="#f1f5f9"];
  }

  LLM [label="LLM API\nGemini / Groq / OpenAI", fillcolor="#ede9fe", color="#6d28d9"];
  DB  [label="Supabase (PostgreSQL)\ncases, orders, inventory,\nsuppliers, rfqs, actions_log", shape=cylinder, fillcolor="#f1f5f9", color="#334155"];
  TG  [label="Telegram Bot\napprovals + escalations", fillcolor="#fef3c7", color="#b45309"];
  MAIL [label="Email / webhook\nRFQs and customer notices", fillcolor="#dcfce7", color="#15803d"];
  DASH [label="Dashboard (static HTML)\ncase timeline, KPIs", fillcolor="#e0f2fe", color="#0369a1"];

  IN -> W1;
  W1 -> W2 [label="case"];
  W2 -> W3 [label="plan"];
  W3 -> W4 [label="open case"];
  W4 -> W2 [label="re-plan", style=dashed, color="#ea4b71", fontcolor="#ea4b71"];
  W3 -> W5 [label="RFQ", style=dashed];
  W5 -> W3 [label="reply (resume)", style=dashed];

  W2 -> LLM [dir=both, style=dotted, ltail=cluster_n8n, label="extraction, reasoning,\nquote parsing"];
  W4 -> DB  [dir=both, ltail=cluster_n8n, label="read / write case state"];

  W3 -> MAIL;
  W3 -> TG;
  W4 -> TG [label="escalate"];
  TG -> W3 [label="approve / reject", style=dashed];
  DB -> DASH [label="realtime"];
}
