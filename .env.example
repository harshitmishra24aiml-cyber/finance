# Copy to .env and fill in. NEVER commit the real .env file.

# --- n8n ---
N8N_HOST=localhost
N8N_PORT=5678
N8N_WEBHOOK_URL=http://localhost:5678/
N8N_ENCRYPTION_KEY=change-me

# --- LLM (use one) ---
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
LLM_MODEL=gemini-2.0-flash

# --- Database (Supabase) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=

# --- Telegram approvals and escalations ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Email intake (optional, webhook intake works without it) ---
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=

# --- Business rules (see data/seed_config.json) ---
APPROVAL_SPEND_LIMIT_INR=150000
MIN_EXTRACTION_CONFIDENCE=0.7
